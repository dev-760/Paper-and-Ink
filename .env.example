# Server-side AI & OCR (Google Gemini API) - NEVER expose in Vite client bundles
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Server-side News Providers - NEVER expose in Vite client bundles
MEDIASTACK_API_KEY=
NEWSDATA_API_KEY=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Client-side public Supabase config (safe for browser via Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Independent Production Hosting & CORS
PORT=3001
ALLOWED_ORIGINS=https://reader.example.com,https://notes.example.com,https://news.example.com
VITE_API_BASE_URL=
# Optional sibling app URLs for cross-app switcher (leave blank on standalone deploys)
VITE_NOTES_URL=
VITE_READER_URL=
VITE_NEWS_URL=
